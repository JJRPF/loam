#!/usr/bin/env python3
"""loam-with-env FILE COMMAND [ARGS...]: run COMMAND with FILE's KEY=VALUE lines in its environment.

Reads the file the way systemd's EnvironmentFile does (no shell expansion, so a `$` in a password is safe):
blank lines and `#` comments are skipped, one pair of surrounding quotes is removed. Values are never printed.
"""
import os
import sys


def load(path):
    env = {}
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith(("#", ";")) or "=" not in line:
                continue
            key, value = line.split("=", 1)
            key, value = key.strip(), value.strip()
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
                value = value[1:-1]
            if key.isidentifier():
                env[key] = value
    return env


if __name__ == "__main__":
    if len(sys.argv) < 3:
        sys.exit("usage: loam-with-env FILE COMMAND [ARGS...]")
    os.environ.update(load(sys.argv[1]))
    os.execvp(sys.argv[2], sys.argv[2:])
