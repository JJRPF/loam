# Local environment template for Loam (copy to .env; never commit .env). Values here are examples or empty.

# --- Data and services -------------------------------------------------------------------------------
# Big files (OSM extract, elevation tiles, GraphHopper graph) live here, outside git. Default: ./data
DATA_DIR=./data
GRAPHHOPPER_URL=http://graphhopper:8989
# The docker compose service names; use localhost when running the API outside compose
DATABASE_URL=postgresql://loam:loam_dev_pw@postgis:5432/loam
API_PORT=8080

# --- Environment -------------------------------------------------------------------------------------
# production | development | test. APP_ENV and LOAM_ENV are the same setting; "production" in either wins.
APP_ENV=development
# Required in production (the in-code development default is refused there)
CONNECTOR_SECRET_KEY=

# --- Sign-in (Firebase Auth) ---------------------------------------------------------------------------
# The API verifies ID tokens for this project
FIREBASE_PROJECT_ID=thepfisters
# Comma-separated verified emails with admin access
ADMIN_EMAILS=
# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=https://loam.thepfisters.com,https://core-node.tailcd5892.ts.net,http://localhost:5173
# Production only: GET navigations arriving on the API's public (Funnel) host are redirected (301) to the web app here
# PUBLIC_APP_ORIGIN=https://loam.thepfisters.com
# API_PUBLIC_HOST=core-node.tailcd5892.ts.net

# Firebase web app config for the frontend build (Firebase console -> Project settings -> Your apps).
# Read at build time. The production build (scripts/web-build-env.sh) sets AUTH_DOMAIN to the app's own domain.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=thepfisters.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=thepfisters
VITE_FIREBASE_APP_ID=
# Build-time frontend settings (production values are in scripts/web-build-env.sh; empty in dev = Vite proxy)
# VITE_API_BASE=
# VITE_PUBLIC_APP_ORIGIN=

# --- Bad-route reports -> GitHub issues (fine-grained PAT, Issues read/write on one repository) ---------
GITHUB_FEEDBACK_TOKEN=
GITHUB_FEEDBACK_REPO=JJRPF/loam

# --- Heat privacy ----------------------------------------------------------------------------------------
# Riders needed before a trail's heat is public (default 3), and whether the creator's imported Garmin rides
# are public as seed heat on trail-class edges (path, track, bridleway, cycleway).
# HEAT_MIN_UNIQUE_RIDERS=3
# SEED_HEAT_PUBLIC=true

# --- Features ----------------------------------------------------------------------------------------------
# Midpoints (via points) are off by default; set true only to try them locally
ENABLE_MIDPOINTS=false
# Connectors stay off unless their current terms are confirmed; Garmin and CubeTrek are on by default
# ENABLE_STRAVA_CONNECTOR=false
# ENABLE_TRAILFORKS_CONNECTOR=false
# ENABLE_GARMIN_LOGIN_CONNECTOR=true
# ENABLE_CUBETREK_CONNECTOR=true

# --- Limits (count/window in seconds, per signed-in user or client IP) ------------------------------------
# RATE_LIMIT_ROUTE=20/600
# RATE_LIMIT_GEOCODE=60/60
# RATE_LIMIT_UPLOAD=30/3600
# RATE_LIMIT_FLAG=60/3600
# ROUTE_CONCURRENCY=2
# ROUTE_WAIT_S=20
