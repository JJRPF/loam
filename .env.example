# Local environment template for Loam (copy to .env; never commit .env)
DATA_DIR=/home/jjr/dev/loam/main/data
GRAPHHOPPER_URL=http://graphhopper:8989
DATABASE_URL=postgresql://loam:loam_dev_pw@postgis:5432/loam
API_PORT=8080

# production | development | test
LOAM_ENV=development
# Required in production (the in-code default is refused there)
CONNECTOR_SECRET_KEY=

# Firebase Auth (GCP project `thepfisters`): the API verifies ID tokens for this project
FIREBASE_PROJECT_ID=thepfisters
# Comma-separated verified emails with admin access
ADMIN_EMAILS=
# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=https://core-node.tailcd5892.ts.net,http://localhost:5173

# Firebase web app config for the frontend build (Firebase console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=thepfisters.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=thepfisters
VITE_FIREBASE_APP_ID=

# In-app "Report bad route" -> GitHub issues (fine-grained PAT, JJRPF/loam Issues read/write)
GITHUB_FEEDBACK_TOKEN=
